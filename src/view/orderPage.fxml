<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.orderController">

    <!-- TOP -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 20; -fx-background-color: #4B2E2B;">

            <children>

                <Label text="Order Management" textFill="WHITE">

                    <font>
                        <Font name="System Bold" size="28" />
                    </font>

                </Label>

                <Region HBox.hgrow="ALWAYS" />

                <TextField fx:id="searchField" onKeyReleased="#searchOrder" prefWidth="250" promptText="Search Order..." />

                <Button fx:id="refreshBtn" onAction="#refreshOrders" styleClass="dashboard-btn" stylesheets="@dashboard-btn.css" text="Refresh" />

                <Button fx:id="dashboardBtn" onAction="#goToDashboard" styleClass="dashboard-btn" stylesheets="@dashboard-btn.css" text="← Dashboard" />

            </children>

        </HBox>
    </top>

    <!-- CENTER -->
    <center>

        <TableView fx:id="orderTable">

            <columns>

                <TableColumn fx:id="serialColumn" prefWidth="100" text="SL" />

                <TableColumn fx:id="customerColumn" prefWidth="228.0" text="Customer" />

                <TableColumn fx:id="productColumn" prefWidth="173.60000610351562" text="Product" />

                <TableColumn fx:id="quantityColumn" prefWidth="156.79998779296875" text="Quantity" />

                <TableColumn fx:id="totalColumn" prefWidth="172.53326416015625" text="Total" />

                <TableColumn fx:id="statusColumn" prefWidth="169.333251953125" text="Status" />

            </columns>

        </TableView>

    </center>

    <!-- BOTTOM -->
    <bottom>

        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #4B2E2B;">

            <children>

                <HBox spacing="15">

                    <children>

                        <TextField fx:id="customerNameField" prefWidth="220" promptText="Customer Name" />

                        <TextField fx:id="productNameField" prefWidth="220" promptText="Product Name" />

                        <TextField fx:id="quantityField" prefWidth="120" promptText="Quantity" />

                    </children>

                </HBox>

                <HBox alignment="CENTER_RIGHT" spacing="15">

                    <children>

                        <Button fx:id="addOrderBtn" onAction="#addOrder" styleClass="dashboard-btn" stylesheets="@dashboard-btn.css" text="Add Order" />

                        <Button fx:id="updateOrderBtn" onAction="#updateOrder" styleClass="dashboard-btn" stylesheets="@dashboard-btn.css" text="Update Order" />

                        <Button fx:id="deleteOrderBtn" onAction="#deleteOrder" styleClass="dashboard-btn" stylesheets="@dashboard-btn.css" text="Delete Order" />

                        <Button fx:id="completeOrderBtn" onAction="#completeOrder" styleClass="dashboard-btn" stylesheets="@dashboard-btn.css" text="Complete Order" />

                    </children>

                </HBox>

            </children>

        </VBox>

    </bottom>

</BorderPane>
