<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.salesController">
   <top>
        <VBox spacing="20" BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
         <HBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="200.0" spacing="10.0" style="-fx-background-color: #4B2E2B;" VBox.vgrow="ALWAYS">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
               <Label text="Sales" textFill="WHITE">
                  <font>
                     <Font name="System Bold" size="28.0" />
                  </font>
               </Label>
               <Region prefHeight="40.0" prefWidth="602.0" />
               <Button mnemonicParsing="false" styleClass="dashboard-btn" stylesheets="@dashboard-btn.css" text="← Dashboard" />
            </children>
         </HBox>

            <!-- Summary Cards -->
            <HBox spacing="20">

                <VBox fx:id="totalSalesCard" alignment="CENTER" maxWidth="Infinity" spacing="10" HBox.hgrow="ALWAYS">

                    <padding>
                        <Insets bottom="20" left="20" right="20" top="20" />
                    </padding>

                    <Label text="Total Sales" />
                    <Label fx:id="totalSalesLabel" text="৳0" />

                </VBox>

                <VBox fx:id="totalOrdersCard" alignment="CENTER" maxWidth="Infinity" spacing="10" HBox.hgrow="ALWAYS">

                    <padding>
                        <Insets bottom="20" left="20" right="20" top="20" />
                    </padding>

                    <Label text="Total Orders" />
                    <Label fx:id="totalOrdersLabel" text="0" />

                </VBox>

                <VBox fx:id="avgOrderCard" alignment="CENTER" maxWidth="Infinity" spacing="10" HBox.hgrow="ALWAYS">

                    <padding>
                        <Insets bottom="20" left="20" right="20" top="20" />
                    </padding>

                    <Label text="Average Order" />
                    <Label fx:id="avgOrderLabel" text="৳0" />

                </VBox>

            </HBox>

            <!-- Filter -->
            <HBox alignment="CENTER_LEFT" prefHeight="26.0" prefWidth="622.0" spacing="10">
            <Region prefHeight="26.0" prefWidth="56.0" />

                <Label text="From" />

                <DatePicker fx:id="fromDatePicker" />
            <Region prefHeight="26.0" prefWidth="152.0" />

                <Label text="To" />

                <DatePicker fx:id="toDatePicker" />

                <Button fx:id="searchButton" onAction="#handleSearch" prefHeight="26.0" prefWidth="92.0" text="Search" />

            </HBox>

            <!-- Chart -->
            <LineChart fx:id="salesChart" minHeight="250" VBox.vgrow="ALWAYS">

                <xAxis>
                    <CategoryAxis label="Date" />
                </xAxis>

                <yAxis>
                    <NumberAxis label="Sales" />
                </yAxis>

            </LineChart>

            <!-- Table -->
            <TableView fx:id="salesTable" VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="productColumn" text="Product" />

                    <TableColumn fx:id="quantityColumn" text="Quantity" />

                    <TableColumn fx:id="priceColumn" text="Price" />

                    <TableColumn fx:id="totalColumn" text="Total" />

                    <TableColumn fx:id="dateColumn" text="Date" />

                </columns>

            </TableView>

        </VBox>
   </top>

</BorderPane>
